# ---------------------------------------------------------------------------
# boasvindas.online — variáveis de ambiente
#
# Copie para .env e preencha. NUNCA versione o .env.
#
# Regra: tudo que começa com VITE_ é embutido no bundle e fica PÚBLICO.
#        Segredos ficam apenas nas variáveis do backend (sem prefixo VITE_).
# ---------------------------------------------------------------------------


# ===========================================================================
# FRONTEND (boasvindas-site) — público, embutido no build
# ===========================================================================

# Origem da API. Deixe VAZIO em produção: o Nginx Proxy Manager serve o site e
# /api/ no mesmo domínio, então o caminho relativo já funciona e o cookie de
# sessão é first-party. Só preencha em setups de origem separada.
VITE_API_BASE_URL=


# ===========================================================================
# BACKEND (boasvindas-api) — SEGREDOS, nunca com prefixo VITE_
# ===========================================================================

# Postgres. Formatos aceitos:
#   VPS/Coolify: postgres://USUARIO:SENHA@boasvindas-db:5432/boasvindas
#   Neon:        postgres://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/boasvindas?sslmode=require
DATABASE_URL=postgres://usuario:senha@boasvindas-db:5432/boasvindas

# Defina como "require" quando o Postgres exigir TLS (Neon exige; o Postgres
# local da VPS, na mesma rede Docker, normalmente não).
DATABASE_SSL=

# Tamanho máximo do pool de conexões.
DATABASE_POOL_MAX=10

# Segredo de assinatura do JWT de sessão. Gere com:
#   openssl rand -base64 32
# Trocar este valor invalida todas as sessões ativas.
AUTH_SECRET=

# Origens autorizadas a enviar requisições com cookie (separadas por vírgula).
CORS_ORIGINS=https://boasvindas.online,https://www.boasvindas.online

# Origem pública do site.
PUBLIC_ORIGIN=https://boasvindas.online

# Nome do cookie de sessão e validade em segundos (padrão: 30 dias).
SESSION_COOKIE_NAME=bv_session
SESSION_MAX_AGE=2592000

# Bind do servidor. Em container, mantenha 0.0.0.0.
HOST=0.0.0.0
PORT=3000

# "production" ativa o atributo Secure no cookie de sessão.
NODE_ENV=production


# ===========================================================================
# POSTGRES no Coolify (apenas se você subir o banco pelo docker-compose.postgres.yml)
# ===========================================================================
POSTGRES_USER=boasvindas
POSTGRES_PASSWORD=
POSTGRES_DB=boasvindas
